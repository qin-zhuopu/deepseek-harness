# DeepSeek Harness (dsh) — container image (INTERNAL / air-gapped variant)
# Build:   docker build -t dsh:dev -f Dockerfile.internal .
# Run:     docker run -d --name dsh-web --network host dsh:dev
#
# Use this instead of ./Dockerfile on hosts with NO public egress (e.g. the
# 10.1.17.58 app server). Everything is pulled through the internal Jereh
# Nexus mirror; nothing here reaches registry.npmjs.org / dl-cdn.
#
# Differences from the public ./Dockerfile:
#   • base image is pulled from harbor by default (node:24 is mirrored there)
#   • corepack is pointed at Nexus (it otherwise hardcodes registry.npmjs.org
#     to fetch pnpm, which is unreachable air-gapped)
#   • pnpm install runs --no-frozen-lockfile so a locally-adjusted lockfile
#     (e.g. release-age exclusions) still resolves.

# Build arguments, defaulted to the internal Jereh mirrors; a build host with
# different mirrors overrides them via --build-arg (same redirect pattern as
# docker/dsh-aio/Dockerfile.dev):
#   NODE_IMAGE    base image, harbor mirror by default
#   NPM_REGISTRY  npm/corepack registry, internal Nexus by default
ARG NODE_IMAGE=harbor.jereh.cn/base/node:24
ARG NPM_REGISTRY=https://nexus.jereh.cn/repository/npm-public/

FROM ${NODE_IMAGE}

# Re-declare after FROM: ARGs declared before the first FROM are not visible
# inside the stage, and an unset expansion would silently empty the ENV below
# and send corepack back to registry.npmjs.org.
ARG NPM_REGISTRY

# ── corepack + pnpm (pinned by repo), fetched through the configured registry ──
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
ENV COREPACK_INTEGRITY_KEYS=0
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

# ── npm through the configured registry ──
RUN npm config set registry ${NPM_REGISTRY}

# ── app ──
WORKDIR /workspaces/deepseek-harness

# Warm the pnpm store from the lockfile alone: this layer only invalidates
# when dependencies change, so source-only commits keep the ~900-package
# download cached (Nexus round-trips make a cold install the build's floor).
# pnpm fetch also needs every file the lockfile's patchedDependencies point at.
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches/ patches/
RUN pnpm fetch

COPY . .

# Install from the warmed store (lockfile may carry local mirror/policy
# tweaks); fetch's store makes this a link step unless the lockfile moved.
# fetch leaves node_modules/.pnpm marked as done, which makes install skip
# workspace linking entirely; drop it so install relinks from the warm store.
RUN rm -rf node_modules && pnpm install --no-frozen-lockfile
# The loader resolves @deepseek-ai plugin packages by name from the loader's
# own location; pnpm only links what the dependency graph references, so link
# every workspace package explicitly and prove the gate's imports resolve.
COPY docker/dsh/link-workspaces.mjs ./
RUN node docker/dsh/link-workspaces.mjs  && test -d node_modules/@deepseek-ai/dsh-client-ui-vnc-preview  && test -d node_modules/@deepseek-ai/cordis-plugin-hmr


# The build context has no .git, so provide the source commit explicitly.
# client-build-environment.ts uses this instead of calling `git rev-parse HEAD`.
ARG DSH_CLIENT_COMMIT_HASH=b150a551b8d465e31e418e1b2eaf5e79bbb7d28e
ENV DSH_CLIENT_COMMIT_HASH=${DSH_CLIENT_COMMIT_HASH}
# Bake time of the docker build (passed by docker/build-dsh-aio-dev-*.sh).
ARG DSH_BUILD_TS=unknown
ENV DSH_BUILD_TS=${DSH_BUILD_TS}

# Build library + web artifacts
RUN pnpm run build

# dsh web listens on 3080 by default
EXPOSE 3080

# Container has no browser: --no-open keeps it headless.
CMD ["pnpm", "dsh", "web", "--no-open"]
