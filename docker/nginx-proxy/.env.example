# 复制为 .env 并填值（chmod 600）。compose 自动读取。同目录的 .env 与
# certs/ 均被 .gitignore 忽略，不入库。
#
# dsh-aio 镜像 tag（内容确定，由 docker/ci-dsh-aio-arm64.sh -p 推送的
# dev-arm64-<sha>；避免用会被覆盖的滚动 tag dev-arm64）
DSH_IMAGE=harbor.jereh.cn/base/dsh-aio:dev-arm64-<sha>
# litellm.jereh.cn 的 API key（dshhome/.dsh/settings.yaml 里 nr 提供方
# 通过 NR_API_KEY 引用）
NR_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx
# 可选：屏幕几何（VNC 桌面分辨率）
SCREEN_GEOMETRY=576x1440x24
