# =====================================================================
# DeepSeek Harness — ALL-IN-ONE image (PRODUCTION / air-gapped variant)
# dsh web + Chrome (CDP) + Xvnc + noVNC + chrome-devtools MCP, prewired.
#
# Build:  docker build -t dsh-aio:prod -f Dockerfile.prod.internal .
# Run:    docker run -d --name dsh-aio --network host --shm-size=1g \
#             -e NR_API_KEY=<your-key> dsh-aio:prod
# Open:   dsh Web UI  -> http://127.0.0.1:3080/
#         Chrome view -> http://127.0.0.1:6080/vnc.html
#
# Combines the variants:
#   • PRODUCTION: boots dsh from the COMPILED CLI entry (apps/cli/lib/bin.js)
#     via entrypoint.prod.sh — no runtime tsx transpile, ~1s startup.
#   • Xvnc + resize sidecar: noVNC stays in smooth resize=scale mode while
#     the desktop geometry follows the viewer's viewport (debounced), so the
#     picture fills the frame without the flicker of resize=remote.
#   • INTERNAL: for hosts with NO public egress (e.g. 10.1.17.58). node
#     comes from harbor; the apt stack is pulled through the internal Nexus
#     apt mirror with serialized downloads (the mirror 502s under apt's
#     default parallel fetches).
#
# NOTE: stage 1 needs dsh:dev built first (from ../../Dockerfile.internal).
# The full workspace node_modules is kept — `pnpm prune --prod` collapses the
# pnpm workspace symlink tree and breaks module resolution. --network host
# is required (dsh web binds 127.0.0.1 only for RCE safety). Only one noVNC
# viewer at a time — every viewer runs fit-resize and they would fight.
# =====================================================================

# ---- Stage 1: reuse the already-built dsh app (compiled lib/ + web dist) ----
FROM dsh:dev AS dshbuild
# /app is fully installed + built here.

# ---- Stage 2: runtime on the Chrome base ----
FROM harbor.jereh.cn/base/ubuntu:24.04-node22-python312-chrome

# Node 24 in an isolated prefix (base image ships an unusable nvm node).
COPY --from=harbor.jereh.cn/base/node:24 /usr/local/bin/node /opt/node/bin/node
COPY --from=harbor.jereh.cn/base/node:24 /usr/local/lib/node_modules/npm /opt/node/lib/node_modules/npm
ENV PATH=/opt/node/bin:$PATH
RUN ln -sf /opt/node/lib/node_modules/npm/bin/npm-cli.js /opt/node/bin/npm \
 && npm config set registry https://nexus.jereh.cn/repository/npm-public/ \
 && npm install -g pnpm@11.7.0 chrome-devtools-mcp@1.7.0

# Display/VNC stack via the internal Nexus mirror; serialized downloads +
# retries because the mirror 502s under apt's default parallel fetches.
RUN sed -i 's|http://mirrors.aliyun.com/ubuntu/|http://10.1.7.49:8081/repository/apt-aliyun/|g' /etc/apt/sources.list \
 && apt-get -o Acquire::Retries=8 -o Acquire::http::Pipeline-Depth=0 -o Acquire::Queue-Mode=access update \
 && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=8 -o Acquire::http::Pipeline-Depth=0 -o Acquire::Queue-Mode=access install -y --no-install-recommends \
      tigervnc-standalone-server wmctrl fluxbox novnc websockify x11-utils curl \
 && rm -rf /var/lib/apt/lists/*

# Desktop-fit helpers (see Dockerfile.prod for the rationale).
COPY vnc-resize-sidecar.py /usr/local/bin/vnc-resize-sidecar.py
COPY fit-resize.js /usr/share/novnc/fit-resize.js
COPY patch-vnc-html.py /usr/local/bin/patch-vnc-html.py
COPY front-proxy.js /usr/local/bin/front-proxy.js
RUN chmod +x /usr/local/bin/vnc-resize-sidecar.py \
 && python3 /usr/local/bin/patch-vnc-html.py /usr/share/novnc/vnc.html

# The built dsh application.
COPY --from=dshbuild /app /app

# Pre-wired DSH_HOME: web profile, nr provider, default model, chrome MCP patch.
# (no credentials, no sessions — NR_API_KEY comes from -e at runtime)
COPY dshhome/.dsh /root/.dsh

# Supervisor that launches the whole stack from the COMPILED entry.
COPY entrypoint.prod.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV DSH_HOME=/root/.dsh
# dsh web (3080), noVNC (6080), resize sidecar (6081), raw VNC (5900),
# CDP (9222), front-proxy (8080, only when FRONT_PORT is set)
EXPOSE 3080 6080 6081 5900 9222 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
