# =====================================================================
# DeepSeek Harness — ALL-IN-ONE image (INTERNAL / air-gapped variant)
# dsh web + Chrome (CDP) + noVNC + chrome-devtools MCP, pre-wired.
#
# Build:  docker build -t dsh-aio:dev -f Dockerfile.internal .
# Run:    docker run -d --name dsh-aio --network host --shm-size=1g \
#             -e NR_API_KEY=<your-key> dsh-aio:dev
# Open:   dsh Web UI  -> http://127.0.0.1:3080/
#         Chrome view -> http://127.0.0.1:6080/vnc.html
#
# Use this instead of ./Dockerfile on hosts with NO public egress (e.g. the
# 10.1.17.58 app server). node comes from harbor and the apt VNC stack is
# pulled through the internal Nexus apt mirror.
#
# NOTE: stage 1 needs dsh:dev built first (from ../../Dockerfile.internal).
# --network host is required. dsh web binds 127.0.0.1 only (refuses 0.0.0.0
# for RCE safety), and the baked MCP client reaches Chrome over the shared
# host loopback (127.0.0.1:9222). NR_API_KEY is injected at runtime.
#
# Differences from the public ./Dockerfile:
#   • node:24 copied from harbor by default (not the public library image)
#   • apt sources repointed to the internal Nexus mirror; downloads are
#     serialized (Pipeline-Depth=0, Queue-Mode=access) with retries because
#     the mirror rejects apt's default parallel connections.
#
# Build arguments, defaulted to the internal Jereh mirrors; a build host with
# different mirrors overrides them via --build-arg (same redirect pattern as
# Dockerfile.dev):
#   DSH_IMAGE          stage-1 source of the built /workspaces/deepseek-harness
#   CHROME_BASE_IMAGE  runtime base (harbor)
#   NODE_IMAGE         source of the /opt/node runtime (harbor)
#   NPM_REGISTRY       npm registry for pnpm/chrome-devtools-mcp (Nexus)
#   APT_MIRROR         apt mirror base URL substituted into sources.list
ARG DSH_IMAGE=dsh:dev
ARG CHROME_BASE_IMAGE=harbor.jereh.cn/base/ubuntu:24.04-node22-python312-chrome
ARG NODE_IMAGE=harbor.jereh.cn/base/node:24
ARG NPM_REGISTRY=https://nexus.jereh.cn/repository/npm-public/
ARG APT_MIRROR=http://10.1.7.49:8081/repository/apt-ubuntu-amd64/

# ---- Stage 1: reuse the already-built dsh app ----
FROM ${DSH_IMAGE} AS dshbuild
# /workspaces/deepseek-harness is fully installed + built here.

# ---- Stage 1b: the Node 24 runtime, as a named stage ----
# BuildKit rejects variable expansion in `COPY --from=`, so the argument is
# resolved by this FROM and the copies below reference the stage name.
FROM ${NODE_IMAGE} AS noderuntime

# ---- Stage 2: runtime on the Chrome base ----
FROM ${CHROME_BASE_IMAGE}

# Node 24 in an isolated prefix (base image ships an unusable nvm node).
COPY --from=noderuntime /usr/local/bin/node /opt/node/bin/node
COPY --from=noderuntime /usr/local/lib/node_modules/npm /opt/node/lib/node_modules/npm
ENV PATH=/opt/node/bin:$PATH
# Re-declare NPM_REGISTRY inside this runtime stage: ARGs do not cross FROM
# boundaries, so the top-level default above is invisible here without this line.
ARG NPM_REGISTRY
RUN ln -sf /opt/node/lib/node_modules/npm/bin/npm-cli.js /opt/node/bin/npm \
 && npm config set registry ${NPM_REGISTRY} \
 && npm install -g pnpm@11.7.0 chrome-devtools-mcp@1.7.0

# Display/VNC stack via the internal mirror; serialized downloads + retries
# because the Nexus proxy 502s under apt's default parallel fetches.
# Xvnc (dynamic RandR sizes) replaces the old xvfb+x11vnc pair.
# noble bases ship deb822 /etc/apt/sources.list.d/ubuntu.sources whose URIs
# carry no trailing slash (URIs: http://archive.ubuntu.com/ubuntu); older
# images use /etc/apt/sources.list with trailing slashes. APT_MIRROR must end
# in / and serve the full ubuntu tree (suites and security live inside it);
# the with-slash form is substituted first so neither form doubles a slash.
ARG APT_MIRROR
RUN set -eux; \
    [ "${APT_MIRROR%/}" != "${APT_MIRROR}" ] || { echo "APT_MIRROR must end in /" >&2; exit 1; }; \
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources; do \
      [ -f "$f" ] || continue; \
      for old in http://archive.ubuntu.com/ubuntu http://security.ubuntu.com/ubuntu http://ports.ubuntu.com/ubuntu-ports http://mirrors.aliyun.com/ubuntu; do \
        sed -i -e "s|${old}/|${APT_MIRROR}|g" -e "s|${old}|${APT_MIRROR%/}|g" "$f"; \
      done; \
    done; \
    apt-get -o Acquire::Retries=8 -o Acquire::http::Pipeline-Depth=0 -o Acquire::Queue-Mode=access update \
 && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=8 -o Acquire::http::Pipeline-Depth=0 -o Acquire::Queue-Mode=access install -y --no-install-recommends \
      tigervnc-standalone-server wmctrl fluxbox novnc websockify x11-utils curl \
      autocutsel xsel \
 && rm -rf /var/lib/apt/lists/*

# 安装 jenkins-zh/jcli，供容器内 agent 触发 Jenkins 构建、查看日志与状态。
# 依赖上面 apt 层提供的 curl；按 dpkg 架构自动选择 amd64/arm64 发布包。
# JCLI_DOWNLOAD_BASE 默认指向 MinIO 公开桶里的 v0.0.47 发布包（气隙主机同样可达）；
# 公网构建机可覆盖为 GitHub Release 的下载路径。
# 凭据不写入镜像：运行时由用户在 ~/.jenkins-cli.yaml 提供（由 /root 具名卷持久化）。
ARG JCLI_DOWNLOAD_BASE=https://minio-api.jereh.cn/base/jcli/v0.0.47
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) jcli_arch=amd64 ;; \
      arm64) jcli_arch=arm64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fL "${JCLI_DOWNLOAD_BASE}/jcli-linux-${jcli_arch}.tar.gz" -o /tmp/jcli.tar.gz; \
    mkdir -p /tmp/jcli-extract; \
    tar -xzf /tmp/jcli.tar.gz -C /tmp/jcli-extract; \
    jcli_bin="$(find /tmp/jcli-extract -type f -name jcli | head -n1)"; \
    test -n "$jcli_bin"; \
    install -m 0755 "$jcli_bin" /usr/local/bin/jcli; \
    rm -rf /tmp/jcli.tar.gz /tmp/jcli-extract

# Desktop-fit helpers (see Dockerfile.prod for the rationale).
COPY vnc-resize-sidecar.py /usr/local/bin/vnc-resize-sidecar.py
COPY fit-resize.js /usr/share/novnc/fit-resize.js
COPY patch-vnc-html.py /usr/local/bin/patch-vnc-html.py
COPY front-proxy.js /usr/local/bin/front-proxy.js
# Read-only web file browser backing the GUI's "文件" tab (/files via front-proxy).
COPY files-server /usr/local/bin/files-server
RUN chmod +x /usr/local/bin/vnc-resize-sidecar.py \
 && python3 /usr/local/bin/patch-vnc-html.py /usr/share/novnc/vnc.html

# The built dsh application.
COPY --from=dshbuild /workspaces/deepseek-harness /workspaces/deepseek-harness

# Pre-wired DSH_HOME: web profile, nr provider, default model, chrome MCP patch.
# (no credentials, no sessions — NR_API_KEY comes from -e at runtime)
COPY dshhome/.dsh /root/.dsh
# Opt-in IAM gate overlay, added to the dsh web launch as --patch when DSH_IAM_GATE=1.
COPY dshhome/iam-gate.cordis.patch.yml /root/.dsh/iam-gate.cordis.patch.yml
# Opt-in shared-password gate overlay, added to the dsh web launch as --patch when DSH_AUTH_SECRET is set.
COPY dshhome/jwt-gate.cordis.patch.yml /root/.dsh/jwt-gate.cordis.patch.yml

# Supervisor that launches the whole stack.
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV DSH_HOME=/root/.dsh
# dsh web (3080), noVNC (6080), resize sidecar (6081), raw VNC (5900),
# CDP (9222), front-proxy (8080, only when FRONT_PORT is set)
EXPOSE 3080 6080 6081 5900 9222 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
